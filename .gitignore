# --- Environments and caches ------------------------------------------------------------
.venv/
.claude/worktrees/
node_modules/
__pycache__/
*.py[cod]
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
htmlcov/
build/
dist/
*.egg-info/
*.log

# --- Local configuration and data (never committed) ------------------------------------
.env
.env.*
!.env.example
data/

# --- Generated output: screenshots, dev certificates and keys, captures ------------------
out/
*.pem
*.key
*.crt
*.p12
*.pfx
night-*.txt

# --- Built static files (bun run build writes them; the Dockerfile rebuilds them) -------
frontend/dist/
src/wiggle_outside/web/static/

# --- Design handoffs and archives kept beside the repository, not in it -----------------
_design_fix/
*.zip

# --- Operating-system noise ------------------------------------------------------------
.DS_Store
Thumbs.db

# --- Fonts ---------------------------------------------------------------------------
# The Fontshare Font Licence 2.0 permits self-hosting but forbids redistributing the
# files in a public repository (TC-007); they are supplied at deploy time from private
# storage, as frontend/fonts/README.md says. No font file is tracked; the licence texts
# and the README are.
frontend/fonts/*
frontend/fonts/*.woff2
!frontend/fonts/README.md
!frontend/fonts/OFL-PatrickHand.txt
