# Wiggle Outside settings. Copy to .env for local development; never commit .env.
# Every key is read by src/wiggle_outside/settings.py. Values here are placeholders.

# --- Deployment mode -------------------------------------------------------------
# hosted_live = the product (D48). local = development. replay is inactive (D24).
WO_MODE=local

# --- Server ----------------------------------------------------------------------
WO_HOST=127.0.0.1
WO_PORT=8000

# --- Storage ---------------------------------------------------------------------
# Fly mounts the volume at /data in the hosted product (fly.toml).
WO_DB_PATH=./data/wiggle.sqlite

# --- Providers (fixed in settings; users never supply a URL) ----------------------
WO_NOMINATIM_URL=https://nominatim.openstreetmap.org
WO_OVERPASS_URL=https://overpass-api.de/api/interpreter
# TC-012: where the one permitted retry goes after a timeout or 5xx on the first.
WO_OVERPASS_FALLBACK_URL=https://overpass.kumi.systems/api/interpreter
WO_OPEN_METEO_URL=https://api.open-meteo.com/v1/forecast
# Nominatim's usage policy requires a real contact address in the User-Agent.
WO_CONTACT_EMAIL=you@example.com

# --- Model (hosted product, DEPLOYMENT section 3) --------------------------------
WO_OPENROUTER_URL=https://openrouter.ai/api/v1/chat/completions
WO_MODEL_ID=google/gemma-4-26b-a4b-it
# The approved providers are fixed in code (integrations/openrouter.py, TC-010), not here.
# The key has no WO_ prefix (settings.OPENROUTER_API_KEY_ENV). Never put the real key in
# this file or in a committed .env; in the hosted product it is a Fly secret read from
# the environment. Without it every result is the labelled fallback.
OPENROUTER_API_KEY=

# --- Optional local model (D38, development only; gates nothing) ------------------
WO_OLLAMA_URL=http://127.0.0.1:11434/api/chat

# --- Limits (DEPLOYMENT section 2; starting values, change by tracked change) -----
WO_DAILY_RUN_LIMIT=200
WO_DEADLINE_SECONDS=20

# --- Feature flags ---------------------------------------------------------------
# D39: the optional "What are they into?" field.
WO_D39_ENABLED=true
